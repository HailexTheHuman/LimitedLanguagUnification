<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css">
    <title>Login</title>
</head>
<body>
    <div class="login-container">
        <h2 class="login">Login</h2>
        <h3 style="color: red;" class="login"><%= message %></h3>
        <form action="/login" method="POST" class="login">
            <label for="username" class="login">Username:</label>
            <input type="text" id="username" class="login" name="username" value="<%= username %>" required>
            <br>
            <label for="password" class="login">Password:</label>
            <input type="password" id="password" class="login" name="password" value="<%= password %>" required>
            <br>
            <button type="submit" class="login">Login</button>
        </form>
        <p class="login">No account?
        <a href="/register" class="login"><button>Register</button></a></p>
    </div>
</body>
</html>
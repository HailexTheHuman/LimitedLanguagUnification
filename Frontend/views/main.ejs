<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css">
    <script src="/scripts/main.js" defer></script>
    <title>Main</title>
</head>
<body user-data="<%= JSON.stringify(user) %>">
    <header>
        <h1>Limited Language Unification</h1>
        <a href="/logout">Logout</a>
    </header>
    <div class="mainContent">
        <div class="sidePanel">
            <div class="sideBanner">
                <label for="modelSelection">Select Model</label>
                <select name="model" id="modelSelection">
                    <option value="0" disabled selected>Choose a model</option>
                    <option value="openrouter/free">Free Model</option>
                    <option value="openai/gpt-5-nano">GPT</option>
                    <option value="google/gemini-2.5-flash-lite">Gemini</option>
                    <option value="anthropic/claude-3-haiku">Claude</option>
                </select>
            </div>
            <div id="newConversation" class="conversationSelect">New Conversation</div>
            <div class="sideContent" id="conversationList"></div>
        </div>
        <main>
            <div id="conversation" class="conversation"></div>
            <input type="text" id="userInput" placeholder="Enter your message here...">
            <button id="sendButton">Send</button>
        </main>
    </div>
</body>
</html>